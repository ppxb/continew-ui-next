# Environment variables must be prefixed with VITE_ to reach the client bundle.

# Prefix used by the Vite dev proxy. Requests to it are forwarded to
# VITE_API_BASE_URL with the prefix stripped, which keeps the browser same-origin
# so the backend's HttpOnly refresh-token cookie is first-party.
VITE_API_PREFIX = '/api'

# continew-admin dev server.
VITE_API_BASE_URL = 'http://localhost:8000'

# Client id that must exist in the backend sys_client table.
VITE_CLIENT_ID = 'ef51c9a3e9046c4f2ea45142c8a8344a'

# RSA public key used to encrypt the password before login. Must match the backend
# continew-starter.encrypt.field.public-key value.
VITE_APP_RSA_PUBLIC_KEY = 'MFwwDQYJKoZIhvcNAQEBBQADSwAwSAJBAM51dgYtMyF+tTQt80sfFOpSV27a7t9uaUVeFrdGiVxscuizE7H8SMntYqfn9lp8a5GH5P1/GGehVjUD2gF/4kcCAwEAAQ=='
