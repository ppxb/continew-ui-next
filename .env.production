# Environment variables must be prefixed with VITE_ to reach the client bundle.

# Same-origin deployment by default: the web server proxies /api to the backend.
# Set a full origin here only when the API is served from another domain, and make
# sure that origin is listed in the backend refresh-token cookie allow-list.
VITE_API_BASE_URL = '/api'

# Client id that must exist in the backend sys_client table.
VITE_CLIENT_ID = 'ef51c9a3e9046c4f2ea45142c8a8344a'

# Must match the backend FIELD_ENCRYPT_PUBLIC_KEY value before building for production.
VITE_APP_RSA_PUBLIC_KEY = 'REPLACE_WITH_PRODUCTION_RSA_PUBLIC_KEY'
